generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  EMPLOYEE
  MANAGER
  ADMIN
}

enum PunchType {
  IN
  OUT
  BREAK_START
  BREAK_END
}

enum PunchStatus {
  VALID
  PENDING_SYNC
  INVALID
  ADJUSTED
}

enum InconsistencyType {
  MISSING_IN
  MISSING_OUT
  DUPLICATE
  OUT_OF_LOCATION
  OUT_OF_SCHEDULE
  INCOMPLETE_JOURNEY
  OTHER
}

enum InconsistencyStatus {
  OPEN
  RESOLVED
  IGNORED
}

model Unit {
  id        String   @id @default(cuid())
  name      String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users     User[]
  punches   Punch[]
  settings  UnitSettings?
}

model User {
  id            String    @id @default(cuid())
  name          String
  employeeNumber String?  @unique
  registrationData String? @db.Text // dados cadastrais estruturados importados de fonte oficial
  email         String    @unique
  passwordHash  String?
  role          Role      @default(EMPLOYEE)
  active        Boolean   @default(true)
  scheduleByDay String?
  unitId        String?
  unit          Unit?     @relation(fields: [unitId], references: [id])
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  punches       Punch[]
  audits        PunchAudit[] @relation("AuditAuthor")
  inconsistencies Inconsistency[]
  medicalCertificates MedicalCertificate[] @relation("CertificateEmployee")
  certificatesCreated MedicalCertificate[] @relation("CertificateCreator")
  certificatesCanceled MedicalCertificate[] @relation("CertificateCanceler")
  employeeRequests EmployeeRequest[] @relation("RequestEmployee")
  requestsReviewed EmployeeRequest[] @relation("RequestReviewer")
}

model Punch {
  id              String       @id @default(cuid())
  userId          String
  user            User         @relation(fields: [userId], references: [id])
  unitId          String?
  unit            Unit?        @relation(fields: [unitId], references: [id])

  type            PunchType
  timestamp       DateTime     // marked_at: horário original em que o funcionário realizou o registro
  clientTimestamp DateTime?    // horário original informado pelo dispositivo, mantido para compatibilidade
  syncedAt        DateTime?    // synced_at: horário em que o servidor recebeu a marcação
  syncStatus      String       @default("SYNCED") // PENDING | SYNCED | FAILED | OFFLINE | RETRYING
  syncAttempts    Int          @default(0)
  syncError       String?
  deviceId        String?
  deviceOs        String?
  appVersion      String?
  connectivity    String?

  latitude        Float?
  longitude       Float?
  accuracy        Float?
  locationCapturedAt DateTime?
  locationValid   Boolean      @default(false)

  status          PunchStatus  @default(VALID)
  origin          String       @default("WEB") // WEB | OFFLINE | ADJUSTED

  // Para rastreabilidade offline
  clientId        String?      @unique // id gerado no dispositivo

  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  audits          PunchAudit[]
  inconsistencies Inconsistency[]

  @@index([userId, timestamp])
  @@index([unitId, timestamp])
  @@index([status])
}

model PunchAudit {
  id          String   @id @default(cuid())
  punchId     String
  punch       Punch    @relation(fields: [punchId], references: [id])

  changedById String
  changedBy   User     @relation("AuditAuthor", fields: [changedById], references: [id])

  field       String   // ex: "timestamp", "type", "status"
  oldValue    String?
  newValue    String?
  reason      String?

  createdAt   DateTime @default(now())

  @@index([punchId])
}

model Inconsistency {
  id          String              @id @default(cuid())
  userId      String
  user        User                @relation(fields: [userId], references: [id])
  punchId     String?
  punch       Punch?              @relation(fields: [punchId], references: [id])

  type        InconsistencyType
  status      InconsistencyStatus @default(OPEN)
  description String?
  detectedAt  DateTime            @default(now())
  resolvedAt  DateTime?
  resolvedBy  String?

  @@index([status])
  @@index([userId, status])
}

model MedicalCertificate {
  id             String   @id @default(cuid())
  type           String   @default("DIA_INTEGRAL")
  userId         String
  user           User     @relation("CertificateEmployee", fields: [userId], references: [id])
  createdById    String
  createdBy      User     @relation("CertificateCreator", fields: [createdById], references: [id])
  canceledById   String?
  canceledBy     User?    @relation("CertificateCanceler", fields: [canceledById], references: [id])
  startDate      DateTime
  endDate        DateTime
  startTime      String?
  endTime        String?
  hoursPerDayMinutes Int?
  daysCount      Int
  workDaysCount  Int?
  documentName   String?
  documentMime   String?
  documentData   String?  @db.Text
  observation    String?
  status         String   @default("ATIVO")
  canceledAt     DateTime?
  cancelReason   String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([userId, startDate, endDate])
  @@index([status])
}

model EmployeeRequest {
  id          String   @id @default(cuid())
  employeeId  String
  employee    User     @relation("RequestEmployee", fields: [employeeId], references: [id])
  reviewerId  String?
  reviewer    User?    @relation("RequestReviewer", fields: [reviewerId], references: [id])
  type        String
  status      String   @default("PENDENTE")
  startDate   DateTime
  endDate     DateTime
  reason      String
  details     String?
  reviewNote  String?
  reviewedAt  DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  @@index([employeeId, status, startDate])
  @@index([status, createdAt])
}

model UnitSettings {
  id                    String  @id @default(cuid())
  unitId                String  @unique
  unit                  Unit    @relation(fields: [unitId], references: [id])

  // Geofence simples (raio em metros)
  latitude              Float?
  longitude             Float?
  geofenceRadiusMeters  Int     @default(150)

  // Regras básicas
  requireLocation       Boolean @default(true)
  allowOffline          Boolean @default(true)
  maxOfflineHours       Int     @default(24)
  signatureData         String?  @db.Text // assinatura institucional em data URL, acessível apenas ao gestor

  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}
