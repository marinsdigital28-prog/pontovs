generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  EMPLOYEE
  MANAGER
  ADMIN
}

enum PunchType {
  IN
  OUT
  BREAK_START
  BREAK_END
}

enum PunchStatus {
  VALID
  PENDING_SYNC
  INVALID
  ADJUSTED
}

enum InconsistencyType {
  MISSING_IN
  MISSING_OUT
  DUPLICATE
  OUT_OF_LOCATION
  OUT_OF_SCHEDULE
  INCOMPLETE_JOURNEY
  OTHER
}

enum InconsistencyStatus {
  OPEN
  RESOLVED
  IGNORED
}

model Unit {
  id        String   @id @default(cuid())
  name      String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users     User[]
  punches   Punch[]
  settings  UnitSettings?
}

model User {
  id            String    @id @default(cuid())
  name          String
  employeeNumber String?  @unique
  email         String    @unique
  passwordHash  String?
  role          Role      @default(EMPLOYEE)
  active        Boolean   @default(true)
  unitId        String?
  unit          Unit?     @relation(fields: [unitId], references: [id])
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  punches       Punch[]
  audits        PunchAudit[] @relation("AuditAuthor")
  inconsistencies Inconsistency[]
}

model Punch {
  id              String       @id @default(cuid())
  userId          String
  user            User         @relation(fields: [userId], references: [id])
  unitId          String?
  unit            Unit?        @relation(fields: [unitId], references: [id])

  type            PunchType
  timestamp       DateTime     // horário oficial do registro
  clientTimestamp DateTime?    // horário que veio do dispositivo

  latitude        Float?
  longitude       Float?
  accuracy        Float?
  locationValid   Boolean      @default(false)

  status          PunchStatus  @default(VALID)
  origin          String       @default("WEB") // WEB | OFFLINE | ADJUSTED

  // Para rastreabilidade offline
  clientId        String?      @unique // id gerado no dispositivo

  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  audits          PunchAudit[]
  inconsistencies Inconsistency[]

  @@index([userId, timestamp])
  @@index([unitId, timestamp])
  @@index([status])
}

model PunchAudit {
  id          String   @id @default(cuid())
  punchId     String
  punch       Punch    @relation(fields: [punchId], references: [id])

  changedById String
  changedBy   User     @relation("AuditAuthor", fields: [changedById], references: [id])

  field       String   // ex: "timestamp", "type", "status"
  oldValue    String?
  newValue    String?
  reason      String?

  createdAt   DateTime @default(now())

  @@index([punchId])
}

model Inconsistency {
  id          String              @id @default(cuid())
  userId      String
  user        User                @relation(fields: [userId], references: [id])
  punchId     String?
  punch       Punch?              @relation(fields: [punchId], references: [id])

  type        InconsistencyType
  status      InconsistencyStatus @default(OPEN)
  description String?
  detectedAt  DateTime            @default(now())
  resolvedAt  DateTime?
  resolvedBy  String?

  @@index([status])
  @@index([userId, status])
}

model UnitSettings {
  id                    String  @id @default(cuid())
  unitId                String  @unique
  unit                  Unit    @relation(fields: [unitId], references: [id])

  // Geofence simples (raio em metros)
  latitude              Float?
  longitude             Float?
  geofenceRadiusMeters  Int     @default(150)

  // Regras básicas
  requireLocation       Boolean @default(true)
  allowOffline          Boolean @default(true)
  maxOfflineHours       Int     @default(24)

  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}
