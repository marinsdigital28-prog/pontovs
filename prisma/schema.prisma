generator client {
  provider = "prisma-client-js"
}


datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}


model Unit {
  id        String   @id @default(cuid())
  name      String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  users     User[]
  punches   Punch[]
  settings  UnitSettings?
}


model User {
  id            String    @id @default(cuid())
  name          String
  employeeNumber String?  @unique
  cpf           String?  @unique
  jobTitle      String?
  workDays      String?
  scheduleStart String?
  scheduleEnd   String?
  email         String    @unique
  passwordHash  String?
  role          String    @default("EMPLOYEE")
  active        Boolean   @default(true)
  unitId        String?
  unit          Unit?     @relation(fields: [unitId], references: [id])
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  punches       Punch[]
  audits        PunchAudit[] @relation("AuditAuthor")
  inconsistencies Inconsistency[]
}


model Punch {
  id              String       @id @default(cuid())
  userId          String
  user            User         @relation(fields: [userId], references: [id])
  unitId          String?
  unit            Unit?        @relation(fields: [unitId], references: [id])
  type            String
  timestamp       DateTime     // horário oficial do registro
  clientTimestamp DateTime?    // horário que veio do dispositivo
  latitude        Float?
  longitude       Float?
  accuracy        Float?
  locationValid   Boolean      @default(false)
  status          String       @default("VALID")
  origin          String       @default("WEB") // WEB | OFFLINE | ADJUSTED
  clientId        String?      @unique // id gerado no dispositivo
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  audits          PunchAudit[]
  inconsistencies Inconsistency[]
  @@index([userId, timestamp])
  @@index([unitId, timestamp])
  @@index([status])
}


model PunchAudit {
  id          String   @id @default(cuid())
  punchId     String
  punch       Punch    @relation(fields: [punchId], references: [id])
  changedById String
  changedBy   User     @relation("AuditAuthor", fields: [changedById], references: [id])
  field       String   // ex: "timestamp", "type", "status"
