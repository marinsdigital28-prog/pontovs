generator client {
  provider = "prisma-client-js"
}




datasource db {
  provider = "postgresql"
  url      = env("POSTGRES_URL_NON_POOLING")
}




model Unit {
  id        String   @id @default(cuid())
  name      String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  users     User[]
  punches   Punch[]
  settings  UnitSettings?
}




model User {
  id            String    @id @default(cuid())
  name          String
  employeeNumber String?  @unique
  cpf           String?   @unique
  jobTitle      String?
  workDays      String?   // JSON: ["SEG", "TER", ...]
  scheduleStart String?
  scheduleEnd   String?
  scheduleByDay String?  // JSON: {"SEG":{"start":"07:00","end":"16:00","mode":"FULL"}}
  profileJson   String?  @db.Text // dados cadastrais extras (documentos, contatos, endereço) — NÃO altera matrícula/jornada
  firstSeenAt   DateTime? // primeiro acesso ao app do colaborador (login/chamada autenticada)
  lastSeenAt    DateTime? // último acesso ao app do colaborador
  email         String    @unique
  passwordHash  String?
  role          String    @default("EMPLOYEE")
  active        Boolean   @default(true)
  unitId        String?
  unit          Unit?     @relation(fields: [unitId], references: [id])
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  punches       Punch[]
  audits        PunchAudit[] @relation("AuditAuthor")
  inconsistencies Inconsistency[]
  securityAuditEvents SecurityAuditEvent[]
  medicalCertificates MedicalCertificate[] @relation("CertificateEmployee")
  certificatesCreated MedicalCertificate[] @relation("CertificateCreator")
  certificatesCanceled MedicalCertificate[] @relation("CertificateCanceler")
  employeeRequests EmployeeRequest[] @relation("RequestEmployee")
  requestsReviewed EmployeeRequest[] @relation("RequestReviewer")
}




model Punch {
  id              String       @id @default(cuid())
  userId          String
  user            User         @relation(fields: [userId], references: [id])
  unitId          String?
  unit            Unit?        @relation(fields: [unitId], references: [id])
  type            String
  timestamp       DateTime
  clientTimestamp DateTime?
  syncedAt        DateTime?
  syncStatus      String       @default("SYNCED")
  syncAttempts    Int          @default(0)
  syncError       String?
  deviceId        String?
  deviceOs        String?
  appVersion      String?
  connectivity    String?
  locationCapturedAt DateTime?
  latitude        Float?
  longitude       Float?
  accuracy        Float?
  locationValid   Boolean      @default(false)
  status          String       @default("VALID")
  origin          String       @default("WEB")
  clientId        String?      @unique
  photoData       String?      @db.Text
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  audits          PunchAudit[]
  inconsistencies Inconsistency[]
  @@index([userId, timestamp])
  @@index([unitId, timestamp])
  @@index([status])
  @@index([syncStatus])
  @@index([syncedAt])
}

model PunchAudit {
  id          String   @id @default(cuid())
  punchId     String
  punch       Punch    @relation(fields: [punchId], references: [id])
  changedById String
  changedBy   User     @relation("AuditAuthor", fields: [changedById], references: [id])
  field       String
  oldValue    String?
  newValue    String?
  reason      String?
  createdAt   DateTime @default(now())
  @@index([punchId])
}

model Inconsistency {
  id          String              @id @default(cuid())
  userId      String
  user        User                @relation(fields: [userId], references: [id])
  punchId     String?
  punch       Punch?              @relation(fields: [punchId], references: [id])
  type        String
  status      String              @default("OPEN")
  description String?
  detectedAt  DateTime            @default(now())
  resolvedAt  DateTime?
  resolvedBy  String?
  @@index([status])
  @@index([userId, status])
}

model UnitSettings {
  id                    String  @id @default(cuid())
  unitId                String  @unique
  unit                  Unit    @relation(fields: [unitId], references: [id])
  latitude              Float?
  longitude             Float?
  geofenceRadiusMeters  Int     @default(150)
  requireLocation       Boolean @default(true)
  allowOffline          Boolean @default(true)
  maxOfflineHours       Int     @default(24)
  signatureData         String?  @db.Text
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}


model MedicalCertificate {
  id             String   @id @default(cuid())
  type           String   @default("DIA_INTEGRAL")
  userId         String
  user           User     @relation("CertificateEmployee", fields: [userId], references: [id])
  createdById    String
  createdBy      User     @relation("CertificateCreator", fields: [createdById], references: [id])
  canceledById   String?
  canceledBy     User?    @relation("CertificateCanceler", fields: [canceledById], references: [id])
  startDate      DateTime
  endDate        DateTime
  startTime      String?
  endTime        String?
  hoursPerDayMinutes Int?
  daysCount      Int
  workDaysCount  Int?
  documentName   String?
  documentMime   String?
  documentData   String?  @db.Text
  observation    String?
  status         String   @default("ATIVO")
  canceledAt     DateTime?
  cancelReason   String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([userId, startDate, endDate])
  @@index([status])
}

model EmployeeRequest {
  id          String   @id @default(cuid())
  employeeId  String
  employee    User     @relation("RequestEmployee", fields: [employeeId], references: [id])
  reviewerId  String?
  reviewer    User?    @relation("RequestReviewer", fields: [reviewerId], references: [id])
  type        String
  status      String   @default("PENDENTE")
  startDate   DateTime
  endDate     DateTime
  reason           String
  details          String?
  medicalSpecialty String?
  classification   String?
  returnExpected   Boolean?
  documentName     String?
  documentMime     String?
  documentData     String?  @db.Text
  reviewNote       String?
  reviewedAt  DateTime?
  // Lançamento explícito na folha pelo gestor. Aprovação sozinha NÃO abona a folha.
  launchedAt   DateTime?
  launchedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  @@index([employeeId, status, startDate])
  @@index([status, createdAt])
}

model SecurityAuditEvent {
  id           String   @id @default(cuid())
  action       String
  actorId      String?
  actor        User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  resource     String?
  resourceId   String?
  metadataJson String?  @db.Text
  previousHash String
  hash         String   @unique
  createdAt    DateTime @default(now())

  @@index([createdAt])
  @@index([actorId, createdAt])
}

// ---- Verificação automática 17:20 + Pontinho + Ocorrências (aditivo, sem mexer em tabelas antigas) ----

model AppSetting {
  key         String   @id
  value       String   @db.Text
  updatedById String?
  updatedAt   DateTime @updatedAt
}

model AutoCloseRun {
  id          String   @id @default(cuid())
  date        String   // YYYY-MM-DD (America/Sao_Paulo) verificado
  phase       String   // TARDE (17:20 do próprio dia) | MANHA (re-checagem de quem sai depois das 17:20)
  mode        String   // DRY_RUN | REAL
  trigger     String   // cron | manual
  actorId     String?
  summaryJson String   @db.Text
  createdAt   DateTime @default(now())
  @@index([date])
  @@index([createdAt])
}

model Pendencia {
  id             String    @id @default(cuid())
  userId         String
  date           String    // YYYY-MM-DD
  kind           String    // FALTA_BATIDA | POUCAS_BATIDAS | SEM_BATIDAS | FORA_ESCALA | TIPO_ERRADO | PEDIDO_NAO_LANCADO | SEM_FOTO | CONFLITO | SIMULACAO_AJUSTE
  status         String    @default("OPEN") // OPEN | RESOLVED | IGNORED
  title          String
  detail         String    @db.Text
  suggestionJson String?   @db.Text
  dryRun         Boolean   @default(true)
  runId          String?
  resolution     String?
  resolvedAt     DateTime?
  resolvedById   String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  @@unique([userId, date, kind])
  @@index([status, createdAt])
  @@index([userId, date])
}

model AutoAdjustment {
  id          String    @id @default(cuid())
  userId      String
  date        String
  punchId     String    @unique
  type        String
  time        String    // HH:MM
  status      String    @default("ACTIVE") // ACTIVE | UNDONE
  runId       String?
  reason      String
  undoneAt    DateTime?
  undoneById  String?
  undoReason  String?
  createdAt   DateTime  @default(now())
  @@index([userId, date])
  @@index([date])
}

model Ocorrencia {
  id           String    @id @default(cuid())
  userId       String
  date         String    // YYYY-MM-DD
  month        String    // YYYY-MM
  kind         String    // ESQUECEU_BATIDA
  source       String    // AUTO_AJUSTE | PENDENCIA
  detail       String    @db.Text
  pendenciaId  String?
  adjustmentId String?
  status       String    @default("ATIVA") // ATIVA | CANCELADA
  canceledAt   DateTime?
  canceledById String?
  cancelReason String?
  createdAt    DateTime  @default(now())
  @@unique([userId, date, kind])
  @@index([userId, month])
}

model AssistantAction {
  id           String    @id @default(cuid())
  actorId      String
  kind         String    // ADD_PUNCH | CANCEL_ADJUSTED_PUNCH | LANCAR_AUSENCIA | CANCEL_CERTIFICATE | LAUNCH_REQUEST
  payloadJson  String    @db.Text
  summaryJson  String    @db.Text
  status       String    @default("PROPOSTA") // PROPOSTA | CONFIRMADA | CANCELADA | ERRO | EXPIRADA
  resultJson   String?   @db.Text
  expiresAt    DateTime
  decidedAt    DateTime?
  createdAt    DateTime  @default(now())
  @@index([actorId, createdAt])
}

// Aviso "você esqueceu de bater" mostrado no ponto + comprovante de ciência do colaborador.
model PunchWarning {
  id           String    @id @default(cuid())
  userId       String
  issueDate    String    // dia da batida esquecida (YYYY-MM-DD)
  kind         String    // FALTA_BATIDA
  message      String    @db.Text
  missingJson  String?   @db.Text
  shownCount   Int       @default(0)
  firstShownAt DateTime?
  lastShownAt  DateTime?
  ackAt        DateTime?
  ackDeviceInfo String?
  historyJson  String?   @db.Text // [{at, event: SHOWN|ACK, source}] — comprovante de cada exibição e da ciência
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  @@unique([userId, issueDate, kind])
  @@index([userId, ackAt])
  @@index([issueDate])
}
