generator client {
  provider = "prisma-client-js"
}




datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}




model Unit {
  id        String   @id @default(cuid())
  name      String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  users     User[]
  punches   Punch[]
  settings  UnitSettings?
}




model User {
  id            String    @id @default(cuid())
  name          String
  employeeNumber String?  @unique
  cpf           String?   @unique
  jobTitle      String?
  workDays      String?   // JSON: ["SEG", "TER", ...]
  scheduleStart String?
  scheduleEnd   String?
  scheduleByDay String?  // JSON: {"SEG":{"start":"07:00","end":"16:00","mode":"FULL"}}
  email         String    @unique
  passwordHash  String?
  role          String    @default("EMPLOYEE")
  active        Boolean   @default(true)
  unitId        String?
  unit          Unit?     @relation(fields: [unitId], references: [id])
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  punches       Punch[]
  audits        PunchAudit[] @relation("AuditAuthor")
  inconsistencies Inconsistency[]
  securityAuditEvents SecurityAuditEvent[]
  medicalCertificates MedicalCertificate[] @relation("CertificateEmployee")
  certificatesCreated MedicalCertificate[] @relation("CertificateCreator")
  certificatesCanceled MedicalCertificate[] @relation("CertificateCanceler")
  employeeRequests EmployeeRequest[] @relation("RequestEmployee")
  requestsReviewed EmployeeRequest[] @relation("RequestReviewer")
}




model Punch {
  id              String       @id @default(cuid())
  userId          String
  user            User         @relation(fields: [userId], references: [id])
  unitId          String?
  unit            Unit?        @relation(fields: [unitId], references: [id])
  type            String
  timestamp       DateTime     // horário oficial do registro
  clientTimestamp DateTime?    // horário que veio do dispositivo
  latitude        Float?
  longitude       Float?
  accuracy        Float?
  locationValid   Boolean      @default(false)
  status          String       @default("VALID")
  origin          String       @default("WEB") // WEB | OFFLINE | ADJUSTED
  clientId        String?      @unique // id gerado no dispositivo
  photoData       String?      @db.Text // evidência fotográfica em data URL; migrar para storage dedicado em produção
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  audits          PunchAudit[]
  inconsistencies Inconsistency[]
  @@index([userId, timestamp])
  @@index([unitId, timestamp])
  @@index([status])
}

model PunchAudit {
  id          String   @id @default(cuid())
  punchId     String
  punch       Punch    @relation(fields: [punchId], references: [id])
  changedById String
  changedBy   User     @relation("AuditAuthor", fields: [changedById], references: [id])
  field       String
  oldValue    String?
  newValue    String?
  reason      String?
  createdAt   DateTime @default(now())
  @@index([punchId])
}

model Inconsistency {
  id          String              @id @default(cuid())
  userId      String
  user        User                @relation(fields: [userId], references: [id])
  punchId     String?
  punch       Punch?              @relation(fields: [punchId], references: [id])
  type        String
  status      String              @default("OPEN")
  description String?
  detectedAt  DateTime            @default(now())
  resolvedAt  DateTime?
  resolvedBy  String?
  @@index([status])
  @@index([userId, status])
}

model UnitSettings {
  id                    String  @id @default(cuid())
  unitId                String  @unique
  unit                  Unit    @relation(fields: [unitId], references: [id])
  latitude              Float?
  longitude             Float?
  geofenceRadiusMeters  Int     @default(150)
  requireLocation       Boolean @default(true)
  allowOffline          Boolean @default(true)
  maxOfflineHours       Int     @default(24)
  signatureData         String?  @db.Text // assinatura institucional em data URL, acessível apenas ao gestor
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}


model MedicalCertificate {
  id             String   @id @default(cuid())
  type           String   @default("DIA_INTEGRAL") // DIA_INTEGRAL | PERIODO_DIAS | HORAS | PERIODO_HORAS | CONSULTA_MEDICA | SAIDA_MEDICA | OUTRO
  userId         String
  user           User     @relation("CertificateEmployee", fields: [userId], references: [id])
  createdById    String
  createdBy      User     @relation("CertificateCreator", fields: [createdById], references: [id])
  canceledById   String?
  canceledBy     User?    @relation("CertificateCanceler", fields: [canceledById], references: [id])
  startDate      DateTime
  endDate        DateTime
  startTime      String?
  endTime        String?
  hoursPerDayMinutes Int?
  daysCount      Int
  workDaysCount  Int?
  documentName   String?
  documentMime   String?
  documentData   String?  @db.Text
  observation    String?
  status         String   @default("ATIVO")
  canceledAt     DateTime?
  cancelReason   String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([userId, startDate, endDate])
  @@index([status])
}

model EmployeeRequest {
  id          String   @id @default(cuid())
  employeeId  String
  employee    User     @relation("RequestEmployee", fields: [employeeId], references: [id])
  reviewerId  String?
  reviewer    User?    @relation("RequestReviewer", fields: [reviewerId], references: [id])
  type        String   // AUSENCIA | TROCA_DIA
  status      String   @default("PENDENTE") // PENDENTE | APROVADO | REJEITADO | CANCELADO
  startDate   DateTime
  endDate     DateTime
  reason           String
  details          String?
  medicalSpecialty String?
  classification   String?
  returnExpected   Boolean?
  documentName     String?
  documentMime     String?
  documentData     String?  @db.Text
  reviewNote       String?
  reviewedAt  DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  @@index([employeeId, status, startDate])
  @@index([status, createdAt])
}

model SecurityAuditEvent {
  id           String   @id @default(cuid())
  action       String
  actorId      String?
  actor        User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  resource     String?
  resourceId   String?
  metadataJson String?  @db.Text
  previousHash String
  hash         String   @unique
  createdAt    DateTime @default(now())

  @@index([createdAt])
  @@index([actorId, createdAt])
}
