generator client {
  provider = "prisma-client-js"
}




datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}




model Unit {
  id        String   @id @default(cuid())
  name      String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  users     User[]
  punches   Punch[]
  settings  UnitSettings?
}




model User {
  id            String    @id @default(cuid())
  name          String
  employeeNumber String?  @unique
  cpf           String?   @unique
  jobTitle      String?
  workDays      String?   // JSON: ["SEG", "TER", ...]
  scheduleStart String?
  scheduleEnd   String?
  email         String    @unique
  passwordHash  String?
  role          String    @default("EMPLOYEE")
  active        Boolean   @default(true)
  unitId        String?
  unit          Unit?     @relation(fields: [unitId], references: [id])
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  punches       Punch[]
  audits        PunchAudit[] @relation("AuditAuthor")
  inconsistencies Inconsistency[]
  securityAuditEvents SecurityAuditEvent[]
}




model Punch {
  id              String       @id @default(cuid())
  userId          String
  user            User         @relation(fields: [userId], references: [id])
  unitId          String?
  unit            Unit?        @relation(fields: [unitId], references: [id])
  type            String
  timestamp       DateTime     // horário oficial do registro
  clientTimestamp DateTime?    // horário que veio do dispositivo
  latitude        Float?
  longitude       Float?
  accuracy        Float?
  locationValid   Boolean      @default(false)
  status          String       @default("VALID")
  origin          String       @default("WEB") // WEB | OFFLINE | ADJUSTED
  clientId        String?      @unique // id gerado no dispositivo
  photoData       String?      @db.Text // evidência fotográfica em data URL; migrar para storage dedicado em produção
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  audits          PunchAudit[]
  inconsistencies Inconsistency[]
  @@index([userId, timestamp])
  @@index([unitId, timestamp])
  @@index([status])
}

model PunchAudit {
  id          String   @id @default(cuid())
  punchId     String
  punch       Punch    @relation(fields: [punchId], references: [id])
  changedById String
  changedBy   User     @relation("AuditAuthor", fields: [changedById], references: [id])
  field       String
  oldValue    String?
  newValue    String?
  reason      String?
  createdAt   DateTime @default(now())
  @@index([punchId])
}

model Inconsistency {
  id          String              @id @default(cuid())
  userId      String
  user        User                @relation(fields: [userId], references: [id])
  punchId     String?
  punch       Punch?              @relation(fields: [punchId], references: [id])
  type        String
  status      String              @default("OPEN")
  description String?
  detectedAt  DateTime            @default(now())
  resolvedAt  DateTime?
  resolvedBy  String?
  @@index([status])
  @@index([userId, status])
}

model UnitSettings {
  id                    String  @id @default(cuid())
  unitId                String  @unique
  unit                  Unit    @relation(fields: [unitId], references: [id])
  latitude              Float?
  longitude             Float?
  geofenceRadiusMeters  Int     @default(150)
  requireLocation       Boolean @default(true)
  allowOffline          Boolean @default(true)
  maxOfflineHours       Int     @default(24)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}


model SecurityAuditEvent {
  id           String   @id @default(cuid())
  action       String
  actorId      String?
  actor        User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  resource     String?
  resourceId   String?
  metadataJson String?  @db.Text
  previousHash String
  hash         String   @unique
  createdAt    DateTime @default(now())

  @@index([createdAt])
  @@index([actorId, createdAt])
}
